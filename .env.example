# Variáveis são lidas do processo. Opcional: node --env-file=.env --import tsx apps/api/src/server.ts
SENTINEL_ORIGIN=http://127.0.0.1:4310
SENTINEL_PORT=4310
# V6.6: PostgreSQL nativo local é o banco operacional principal.
SENTINEL_DATABASE_MODE=postgres
# Forneça URL de banco exclusivo. Migrações e serviço usam identidades distintas.
# DATABASE_URL=postgresql://sentinel:REPLACE@127.0.0.1:5432/sentinel
# Desenvolvimento isolado sem servidor (não é o perfil operacional oficial):
# SENTINEL_DATABASE_MODE=embedded
# SENTINEL_DATA_DIR=/var/lib/isee-sentinel
# SENTINEL_MASTER_KEY=<64 hex chars; alternativamente arquivo local de chave criado pelo CLI>
# SENTINEL_SECURE_COOKIE=true (obrigatório para origin HTTPS)
# Adaptador opcional. Configure somente executável Nmap instalado e verificado.
# SENTINEL_NMAP_PATH=/usr/bin/nmap
# Worker offline opcional: caminho absoluto para Python 3.11 ou superior.
# SENTINEL_PYTHON_PATH=/usr/bin/python3

# Supervisor Rust opcional, compilado localmente. Não executa plugins arbitrários.
# SENTINEL_EXECUTION_PATH=/opt/isee-sentinel/packages/execution-engine/target/release/sentinel-execution
